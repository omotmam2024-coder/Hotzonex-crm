# Supabase project connection (frontend-safe, anon-key only — never the service_role key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Set to "true" to switch campaign dispatch from manual WhatsApp-link mode to
# the provider adapter stub (Twilio / Africa's Talking shaped). Leave "false"
# until a real provider is wired up.
VITE_MESSAGING_PROVIDER_ENABLED=false
